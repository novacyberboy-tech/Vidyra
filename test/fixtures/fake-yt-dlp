// Test double for yt-dlp. It speaks just enough of the real CLI (-J, --flat-playlist/--print search,
// progress lines, after_move DCFILE output, -U) for the server tests. It is NOT used by the app itself.
'use strict';
const fs = require('node:fs');
const path = require('node:path');
const argv = process.argv.slice(2);
const sleep = (ms) => new Promise((r) => setTimeout(r, ms));
const url = argv[argv.length - 1];
// Tests set FAKE_YTDLP_LOG to a file: every call's arguments are appended there as one JSON line.
if (process.env.FAKE_YTDLP_LOG) fs.appendFileSync(process.env.FAKE_YTDLP_LOG, JSON.stringify(argv) + '\n');

(async () => {
  if (argv.includes('--version')) { console.log('2025.10.22'); return; }
  if (argv.includes('-U')) { console.log('yt-dlp is up to date (2025.10.22)'); return; }

  if (argv.includes('-J')) {
    if (/fail/.test(url)) { console.error('ERROR: Unsupported URL: ' + url); process.exit(1); }
    // FAKE_YTDLP_AUDIO_URL: when a test asks for a single audio format, report that direct URL.
    console.log(JSON.stringify({
      ...(process.env.FAKE_YTDLP_AUDIO_URL && argv.includes('-f') ? { url: process.env.FAKE_YTDLP_AUDIO_URL } : {}),
      id: 'abc123xyz00', title: 'Fake video ' + url.slice(-6), uploader: 'Test Channel', duration: 125,
      thumbnail: 'https://example.invalid/thumb.jpg', webpage_url: url, extractor_key: 'Generic',
      formats: [
        { format_id: '137', vcodec: 'avc1.640028', acodec: 'none', height: 1080, fps: 30, ext: 'mp4', filesize: 52428800 },
        { format_id: '299', vcodec: 'avc1.64002a', acodec: 'none', height: 1080, fps: 60, ext: 'mp4', filesize: 78643200 },
        { format_id: '136', vcodec: 'avc1.4d401f', acodec: 'none', height: 720, fps: 30, ext: 'mp4', filesize: 20971520 },
        { format_id: '135', vcodec: 'avc1.4d401e', acodec: 'none', height: 480, fps: 30, ext: 'mp4' },
        { format_id: '140', vcodec: 'none', acodec: 'mp4a.40.2', abr: 128, ext: 'm4a', language: 'en' },
        { format_id: '141', vcodec: 'none', acodec: 'mp4a.40.2', abr: 128, ext: 'm4a', language: 'hi-IN' },
      ],
    }));
    return;
  }

  if (argv.includes('--flat-playlist')) {
    // ytsearch = YouTube, ytmsearch = YouTube Music (its results are songs: titles say "audio", channels are artist topics).
    const m = /(ytmsearch|ytsearch)(\d+):(.*)$/.exec(url);
    if (!m) process.exit(1);
    // FAKE_YTDLP_NO_MUSIC=1 makes YouTube Music search fail like an old yt-dlp would.
    if (m[1] === 'ytmsearch' && process.env.FAKE_YTDLP_NO_MUSIC) {
      console.error('ERROR: Unsupported URL: ytmsearch');
      process.exit(1);
    }
    const music = m[1] === 'ytmsearch';
    if (/slowsearch/.test(m[3])) { await sleep(60_000); }
    const n = Math.min(Number(m[2]), 30);
    for (let i = 1; i <= n; i++) {
      const id = `vid${String(i).padStart(8, '0')}`.slice(0, 11);
      const title = i === 2 ? 'Tabbed\ttitle line' : `${m[3]} ${music ? 'audio ' : ''}result ${i}`;
      const channel = music ? `Artist ${i} - Topic` : 'Channel ' + i;
      console.log([id, `https://www.youtube.com/watch?v=${id}`, 60 + i, channel, 1000 * i, 'NA', title].join('\t'));
      await sleep(30);
    }
    return;
  }

  // Download: write the sample file to the requested output folder and print progress like yt-dlp.
  const oIdx = argv.indexOf('-o');
  const template = oIdx >= 0 ? argv[oIdx + 1] : '';
  const outDir = path.dirname(template);
  const ext = argv.includes('mp3') ? 'mp3' : (argv[argv.indexOf('--merge-output-format') + 1] || 'mp4');
  const slow = /slow/.test(url);
  if (/fail/.test(url)) { console.log('[generic] Downloading'); console.error('ERROR: Unable to download webpage: HTTP Error 403: Forbidden'); process.exit(1); }
  const steps = slow ? 40 : 4;
  for (let i = 0; i <= steps; i++) {
    const pct = ((i / steps) * 100).toFixed(1);
    console.log(`[download] ${pct.padStart(5)}% of ~ 4.20MiB at  2.10MiB/s ETA 00:0${Math.max(0, steps - i) % 10}`);
    await sleep(slow ? 250 : 20);
  }
  const title = ('Fake video ' + url.slice(-6)).replace(/[\/]/g, '_');
  const file = path.join(outDir, `${title} [abc123xyz00].${ext}`);
  const src = process.env.FAKE_YTDLP_SAMPLE;
  if (src && fs.existsSync(src)) fs.copyFileSync(src, file);
  else fs.writeFileSync(file, Buffer.alloc(4096, 1));
  console.log(`DCFILE:${file}`);
})();
