{
  "name": "Vidyra — Universal video & audio downloader",
  "short_name": "Vidyra",
  "description": "Download videos and audio in any quality and format, with a live queue, library, player and built-in terminal.",
  "id": "/",
  "start_url": "/#/download",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#080a0f",
  "theme_color": "#080a0f",
  "lang": "en",
  "categories": ["utilities", "multimedia"],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/logo.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "share_target": {
    "action": "/",
    "method": "GET",
    "params": { "title": "title", "text": "text", "url": "url" }
  },
  "shortcuts": [
    { "name": "Paste a link", "short_name": "Download", "url": "/#/download", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Search videos", "short_name": "Search", "url": "/#/search", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Music", "short_name": "Music", "url": "/#/music", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Queue", "short_name": "Queue", "url": "/#/queue", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
